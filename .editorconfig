root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# .NET source and project files
[*.{cs,csx,vb}]
indent_size = 4
csharp_using_directive_placement = outside_namespace:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

[*.{csproj,slnx,sln,props,targets,xml,config,ruleset}]
indent_size = 2

# Web / config
[*.{js,jsx,ts,tsx,vue,json,jsonc,html,css,scss,yml,yaml}]
indent_size = 2

# Rust (Tauri)
[*.{rs,toml}]
indent_size = 4

# Windows shell scripts — CRLF
[*.{ps1,psm1,cmd,bat}]
end_of_line = crlf
indent_size = 4

# Markdown — preserve trailing spaces (used for hard line breaks)
[*.md]
trim_trailing_whitespace = false
indent_size = 2
