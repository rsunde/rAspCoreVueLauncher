{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (hot reload)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: build",
      "program": "${workspaceFolder}/src/rAspCoreVueLauncher.Api/bin/Debug/net10.0/rAspCoreVueLauncher.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/rAspCoreVueLauncher.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar/v1"
      },
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    {
      "name": "Web (Vite dev)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/rAspCoreVueLauncher.Web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Tauri (desktop dev)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/rAspCoreVueLauncher.Web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "tauri:dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: API + Vue",
      "configurations": ["API (hot reload)", "Web (Vite dev)"],
      "stopAll": true,
      "presentation": { "group": "1_app", "order": 1 }
    },
    {
      "name": "Full Stack: API + Tauri",
      "configurations": ["API (hot reload)", "Tauri (desktop dev)"],
      "stopAll": true,
      "presentation": { "group": "1_app", "order": 2 }
    }
  ]
}
