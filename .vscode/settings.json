{
  "dotnet.defaultSolution": "rAspCoreVueLauncher.slnx",
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/node_modules": false
  },
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/src-tauri/target": true,
    "**/app.db*": true
  },
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#6A061A",
    "titleBar.activeForeground": "#FFFFFF",
    "titleBar.inactiveBackground": "#35030D",
    "titleBar.inactiveForeground": "#FFFFFF",
    "statusBar.background": "#6A061A",
    "activityBar.background": "#6A061A",
    "activityBar.foreground": "#FFFFFF"
  }
}
